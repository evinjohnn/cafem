<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:padding="24dp">

    <!-- Header -->
    <ImageView
        android:id="@+id/icon_logo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_cafe"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/text_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="@string/app_name"
        android:fontFamily="sans-serif-medium"
        android:textSize="24sp"
        android:textColor="@color/text_primary"
        app:layout_constraintStart_toEndOf="@id/icon_logo"
        app:layout_constraintBottom_toBottomOf="@id/icon_logo"
        app:layout_constraintTop_toTopOf="@id/icon_logo" />

    <!-- Status Card -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:background="@drawable/bg_card"
        android:padding="20dp"
        app:layout_constraintTop_toBottomOf="@id/text_title">

        <View
            android:id="@+id/status_indicator"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/bg_card"
            android:backgroundTint="@color/surface_light_grey"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/text_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/status_waiting"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:fontFamily="sans-serif"
            app:layout_constraintStart_toEndOf="@id/status_indicator"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
        
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Controls -->
    <TextView
        android:id="@+id/label_soundstage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_soundstage"
        android:textColor="@color/sony_gold"
        android:textSize="14sp"
        android:layout_marginTop="48dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_status"/>

    <com.google.android.material.slider.Slider
        android:id="@+id/slider_soundstage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0"
        android:valueTo="1000"
        android:stepSize="10"
        app:thumbColor="@color/sony_gold"
        app:trackColorActive="@color/sony_gold"
        app:trackColorInactive="@color/surface_light_grey"
        app:layout_constraintTop_toBottomOf="@id/label_soundstage"/>

    <TextView
        android:id="@+id/label_ambience"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_ambience"
        android:textColor="@color/sony_gold"
        android:textSize="14sp"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/slider_soundstage"/>

    <com.google.android.material.slider.Slider
        android:id="@+id/slider_ambience"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0"
        android:valueTo="6"
        android:stepSize="1"
        app:thumbColor="@color/sony_gold"
        app:trackColorActive="@color/sony_gold"
        app:trackColorInactive="@color/surface_light_grey"
        app:layout_constraintTop_toBottomOf="@id/label_ambience"/>

    <!-- Power Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btn_power"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_power"
        android:layout_marginBottom="32dp"
        app:backgroundTint="@color/surface_dark_grey"
        app:tint="@color/text_secondary"
        app:borderWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>

