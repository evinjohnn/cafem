<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical">
        <shape>
            <solid android:color="#333333"/>
            <corners android:radius="8dp"/>
            <size android:height="8dp"/>
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress" android:gravity="center_vertical">
        <clip>
            <shape>
                <solid android:color="#444444"/>
                <corners android:radius="8dp"/>
                <size android:height="8dp"/>
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress" android:gravity="center_vertical">
        <clip>
            <shape>
                <solid android:color="#00E5FF"/>
                <corners android:radius="8dp"/>
                <size android:height="8dp"/>
            </shape>
        </clip>
    </item>
</layer-list>